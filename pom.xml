<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.controlefinanceiro</groupId>
    <artifactId>controle-financeiro-core</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>controle-financeiro-core</name>
    <description>
        Camada de regras de negocio do sistema de Controle Financeiro,
        extraida do projeto desktop Java Swing (Etapa 6) para reuso pelo
        futuro sistema web. Inclui testes unitarios JUnit 5 (Etapa 7).
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
    </properties>

    <dependencies>
        <!-- JUnit 5 (Jupiter) - usado apenas em testes (escopo "test") -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            Driver JDBC do MySQL - NECESSARIO APENAS em tempo de execucao,
            e apenas se voce for de fato conectar em um banco MySQL real
            usando as classes do pacote repository.jdbc (UsuarioDAO,
            CategoriaDAO, MovimentacaoDAO). A compilacao do projeto e a
            execucao dos testes unitarios (main() e JUnit) NAO dependem
            deste driver, pois usam apenas classes java.sql.* (parte do
            JDK) e os repositorios em memoria (repository.memory).

            Descomente o bloco abaixo se for rodar contra um MySQL real:

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>runtime</scope>
        </dependency>
        -->
    </dependencies>

    <build>
        <finalName>controle-financeiro-core</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Executa os testes JUnit 5 com "mvn test" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Permite gerar um .jar executavel com "mvn package" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.controlefinanceiro.core.app.ControleFinanceiroCoreApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
